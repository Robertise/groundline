# Groundline settings. Copy to .env and adjust.
GROUNDLINE_MODE=mock
GROUNDLINE_DB_PATH=./data/groundline.db
GROUNDLINE_TIMEZONE=Asia/Ho_Chi_Minh
GROUNDLINE_DAILY_SEND_CAP=20
GROUNDLINE_MIN_SECONDS_BETWEEN_SENDS=30
GROUNDLINE_MAX_CONSECUTIVE_ERRORS=3
GROUNDLINE_SEND_LOCK_SECONDS=600

# Required for dry_run and live
GROUNDLINE_X_CLIENT_ID=
GROUNDLINE_X_CLIENT_SECRET=
GROUNDLINE_X_REDIRECT_URI=http://127.0.0.1:8000/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GROUNDLINE_SECRET_KEY=
# Bedrock (credentials come from the standard AWS chain: env vars or an AWS profile)
GROUNDLINE_AWS_REGION=ap-southeast-1
GROUNDLINE_BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
